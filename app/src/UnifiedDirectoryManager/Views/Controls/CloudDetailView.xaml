<UserControl x:Class="UnifiedDirectoryManager.Views.Controls.CloudDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:UnifiedDirectoryManager.Views"
             xmlns:ctrl="clr-namespace:UnifiedDirectoryManager.Views.Controls"
             xmlns:models="clr-namespace:UnifiedDirectoryManager.Models">
    <UserControl.Resources>
        <!-- A CollectionContainer sits outside the visual tree and cannot see the DataContext, so a plain
             {Binding Sections} on it resolves to nothing. The proxy carries it in, which is what lets the
             per-section tabs and the kind-specific tabs share ONE tab strip instead of nesting. -->
        <views:BindingProxy x:Key="VmProxy" Data="{Binding}" />
        <!-- The value control for one property row. Exactly ONE of these is ever instantiated per row: a
             ComboBox whose ItemsSource is null resets its SelectedItem to null and, on a two-way binding,
             writes that null straight back over the property, so the unused editor must not exist at all
             rather than merely be collapsed.
             Neither carries a tooltip of its own: an explanation on every field turned into clutter that
             followed the pointer around. The "?" beside the label is the one place that explains a row. -->
        <DataTemplate x:Key="PropertyTextEditor">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBool}}"
                     TextWrapping="Wrap">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Foreground" Value="#222" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditable}" Value="False">
                                <Setter Property="Background" Value="#F3F3F3" />
                                <Setter Property="Foreground" Value="#666" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DataTemplate>
        <DataTemplate x:Key="PropertyChoiceEditor">
            <ComboBox ItemsSource="{Binding Choices}"
                      SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>
        <!-- A recipient list shows names and writes addresses, so there is nothing here to type. The command
             lives on the view model, which the row's DataContext is not, so it comes through the proxy. -->
        <DataTemplate x:Key="PropertyRecipientEditor">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Edit…" Padding="8,2" Margin="6,0,0,0"
                        VerticalAlignment="Top"
                        Command="{Binding Data.EditRecipientsCommand, Source={StaticResource VmProxy}}"
                        CommandParameter="{Binding}" />
                <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         Background="White" Foreground="#222" />
            </DockPanel>
        </DataTemplate>
        <!-- One property row: label + value. Editable free-text props are white text boxes; editable yes/no
             and enum props are drop-downs, because typing the value would be a spelling test whose wrong
             answers are silent. On-prem-mastered and system props are grayed, read-only text.

             The label column is fixed, so the label has to be bounded: given unbounded width it runs straight
             under the value control ("Membership hidden (permanent)", "Send auto-replies to sender"). It wraps
             rather than being trimmed, because with no tooltip on the field there would be nowhere left to
             read the rest of a truncated name. -->
        <DataTemplate x:Key="PropertyRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" Margin="0"
                               TextWrapping="Wrap" MaxWidth="164" VerticalAlignment="Center" />
                    <!-- Quiet on purpose: one of these sits on nearly every row, so it reads as punctuation
                         until it is wanted. Lighter than the label it follows, and outlined rather than
                         filled. Hover shows the explanation; so does a click, which is what a touch or
                         pointer-shy user reaches for first. -->
                    <Border Width="14" Height="14" CornerRadius="7" Margin="5,0,0,0"
                            BorderBrush="#C4C4C4" BorderThickness="1" Background="Transparent"
                            VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonUp="OnHelpGlyphClick"
                            ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000"
                            Visibility="{Binding HasHelp, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="?" FontSize="9" Foreground="#9B9B9B" Margin="0,-1,0,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border.ToolTip>
                            <!-- A ToolTip element rather than a plain string, so the click handler has an
                                 object to open. It inherits the row's DataContext from its placement target. -->
                            <ToolTip Content="{Binding HelpText}" MaxWidth="380">
                                <ToolTip.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ToolTip.ContentTemplate>
                            </ToolTip>
                        </Border.ToolTip>
                    </Border>
                </StackPanel>
                <!-- The default template is set through the style, not as a local value: a local ContentTemplate
                     outranks a style trigger and the drop-down would never appear.
                     Focusable=False: the wrapper is a layout detail, and without this every row costs two Tab
                     presses, the first landing on a cell that draws a focus rectangle and accepts no input. -->
                <ContentControl Grid.Column="1" Content="{Binding}" Focusable="False" VerticalAlignment="Center">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource PropertyTextEditor}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UsesChoiceEditor}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource PropertyChoiceEditor}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding UsesRecipientEditor}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource PropertyRecipientEditor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Empty state -->
        <TextBlock Text="{Binding EmptyHint}" Foreground="#999" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" Margin="12"
                   Visibility="{Binding EmptyHint, Converter={StaticResource NonEmptyToVis}}" />

        <DockPanel Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
            <!-- Header -->
            <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="8">
                <DockPanel>
                    <!-- Size and usage sits with the mailbox it describes. It is a separate, expensive read (the
                         mailbox store rather than the directory, one mailbox per call), so it is asked for
                         rather than fetched on open. Docked first so a long display name wraps around it. -->
                    <Button DockPanel.Dock="Right" Content="Load size and usage" Margin="8,0,0,0" Padding="8,3"
                            VerticalAlignment="Top" Command="{Binding LoadUsageCommand}"
                            Visibility="{Binding IsMailbox, Converter={StaticResource BoolToVis}}"
                            ToolTip="Reads mailbox size, item counts and last logon. This queries the mailbox itself rather than the directory, so it is slower than the rest of this pane and is not loaded automatically." />
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="White" TextWrapping="Wrap" />
                        <!-- Membership sits directly under the group's name. It was reachable only by
                             double-clicking the row, which nothing advertised; at the far edge of the header
                             it was still easy to miss. The editor itself is unchanged: one implementation, so
                             the two ways in cannot drift. -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Foreground="#DDD" FontSize="11" VerticalAlignment="Center">
                                <Run Text="{Binding SourceLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding KindLabel, Mode=OneWay}" />
                            </TextBlock>
                            <Button Content="Members…" Margin="12,0,0,0" Padding="8,1" FontSize="11"
                                    Command="{Binding ManageMembersCommand}"
                                    Visibility="{Binding IsExchangeGroup, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Add or remove the members of this distribution group." />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Cloud user actions (writes; each confirmed) -->
            <Border DockPanel.Dock="Top" Padding="6" Background="#F7F7F7" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                    Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                <WrapPanel>
                    <Button Content="Disable account" Command="{Binding DisableCommand}" Margin="0,0,6,0"
                            Visibility="{Binding ShowDisable, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Enable account" Command="{Binding EnableCommand}" Margin="0,0,6,0"
                            Visibility="{Binding ShowEnable, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Revoke sessions" Command="{Binding RevokeSessionsCommand}" />
                </WrapPanel>
            </Border>

            <!-- Status / error line (always visible regardless of the active tab) -->
            <Border DockPanel.Dock="Top" Padding="8,4" Background="#FDECEA" BorderBrush="#F5C6C0" BorderThickness="0,0,0,1"
                    Visibility="{Binding Status, Converter={StaticResource NonEmptyToVis}}">
                <TextBlock Text="{Binding Status}" Foreground="#B00020" TextWrapping="Wrap" />
            </Border>

            <!-- Save bar (appears when there are unsaved edits) -->
            <Border DockPanel.Dock="Bottom" Padding="6" Background="#FFF8E1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                    Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}">
                <WrapPanel>
                    <Button Content="Save changes" Command="{Binding SaveCommand}" Margin="0,0,6,0" />
                    <Button Content="Revert" Command="{Binding RevertCommand}" />
                </WrapPanel>
            </Border>

            <!-- One flat tab strip. The property sections come from Sections via the CompositeCollection; the
                 kind-specific tabs below are declared inline. Mixing works because WPF uses an item that is
                 already a TabItem as its own container and skips the item templates for it, so the templates
                 apply only to the CloudPropertySection items. -->
            <TabControl Margin="4" SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <!-- Keyed by TYPE rather than set as the strip's ContentTemplate. A TabControl copies its own
                     ContentTemplate onto every TabItem that declares none, so one ContentTemplate here was
                     being applied to Licenses, Member Of, Members and Actions as well — each of those is
                     already a built control, and each rendered nothing because the template looks for
                     Properties on it. An implicit template applies to the sections and leaves the rest alone.
                     app/build/test-tabselection.ps1 covers it. -->
                <TabControl.Resources>
                    <DataTemplate DataType="{x:Type models:CloudPropertySection}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Properties}"
                                          ItemTemplate="{StaticResource PropertyRow}" Margin="8" />
                        </ScrollViewer>
                    </DataTemplate>
                </TabControl.Resources>
                <TabControl.ItemsSource>
                    <CompositeCollection>
                        <CollectionContainer Collection="{Binding Data.Sections, Source={StaticResource VmProxy}}" />

                <!-- Mailbox actions. The same control the AD edit pane shows, on the same view model type:
                     convert Regular/Shared, set and clear forwarding, and manage delegates. -->
                <TabItem Header="Actions" Visibility="{Binding IsMailbox, Converter={StaticResource BoolToVis}}">
                    <ctrl:ExchangeActionsView DataContext="{Binding Exchange}" />
                </TabItem>

                <!-- Licenses (users) -->
                <TabItem Header="Licenses" Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6"
                                    Visibility="{Binding CanManageLicenses, Converter={StaticResource BoolToVis}}">
                            <Button Content="Assign license…" Command="{Binding AssignLicenseCommand}" Margin="0,0,6,0" />
                            <Button Content="Remove selected" Command="{Binding RemoveLicensesCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=CloudLicensesList}" />
                        </StackPanel>
                        <ListView x:Name="CloudLicensesList" ItemsSource="{Binding Licenses}"
                                  SelectionMode="Extended" VirtualizingStackPanel.IsVirtualizing="False">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="License" Width="200" DisplayMemberBinding="{Binding FriendlyName}" />
                                    <GridViewColumn Header="SKU" Width="160" DisplayMemberBinding="{Binding SkuPartNumber}" />
                                    <GridViewColumn Header="Assigned via" Width="170" DisplayMemberBinding="{Binding AssignedVia}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </TabItem>

                <!-- Member Of (users + devices) -->
                <TabItem Header="Member Of" Visibility="{Binding CanManageMemberships, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Add to groups…" Command="{Binding AddToGroupsCommand}" Margin="0,0,6,0" />
                            <Button Content="Remove selected" Command="{Binding RemoveFromGroupsCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=CloudMembershipsList}" />
                        </StackPanel>
                        <ListView x:Name="CloudMembershipsList" ItemsSource="{Binding Memberships}"
                                  SelectionMode="Extended" VirtualizingStackPanel.IsVirtualizing="False">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Group" Width="220" DisplayMemberBinding="{Binding DisplayName}" />
                                    <GridViewColumn Header="Kind" Width="130" DisplayMemberBinding="{Binding GroupKind}" />
                                    <GridViewColumn Header="Membership" Width="90" DisplayMemberBinding="{Binding MembershipKind}" />
                                    <GridViewColumn Header="Origin" Width="90" DisplayMemberBinding="{Binding Origin}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </TabItem>

                <!-- Members (groups) -->
                <TabItem Header="Members" Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6"
                                    Visibility="{Binding CanAddMembers, Converter={StaticResource BoolToVis}}">
                            <Button Content="Add members…" Command="{Binding AddMembersCommand}" Margin="0,0,6,0" />
                            <Button Content="Paste a list…" Command="{Binding PasteMembersCommand}" Margin="0,0,6,0"
                                    ToolTip="Paste many people at once — addresses, logon names or names — and review what each line resolved to before anything is added." />
                            <Button Content="Remove selected" Command="{Binding RemoveMembersCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=CloudMembersList}" />
                        </StackPanel>
                        <ListView x:Name="CloudMembersList" ItemsSource="{Binding Members}"
                                  SelectionMode="Extended" VirtualizingStackPanel.IsVirtualizing="False"
                                  GridViewColumnHeader.Click="OnMembersHeaderClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding DisplayName}" />
                                    <GridViewColumn Header="UPN / mail" Width="220" DisplayMemberBinding="{Binding Upn}" />
                                    <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding ObjectType}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </TabItem>
                    </CompositeCollection>
                </TabControl.ItemsSource>
            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>
