<UserControl x:Class="UnifiedDirectoryManager.Views.Controls.EditPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:UnifiedDirectoryManager.Views.Controls">
    <UserControl.Resources>
        <!-- Read-only attribute value: looks like static grayed text (no border/fill) but is a real
             TextBox, so the value stays selectable and copyable (drag-select, Ctrl+C, right-click Copy). -->
        <Style x:Key="ReadOnlyValueBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#999" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Cursor" Value="IBeam" />
        </Style>

        <!-- One attribute row: friendly label + value. Editable attributes get a text box; read-only
             attributes are shown as static, grayed-out (but selectable/copyable) text, not an editable field. -->
        <DataTemplate x:Key="FieldRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding FriendlyName}" Style="{StaticResource FieldLabel}"
                           VerticalAlignment="Center" />
                <Grid Grid.Column="1">
                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}" />
                    <TextBox Text="{Binding EditText}" Style="{StaticResource ReadOnlyValueBox}"
                             ToolTip="{Binding EditText}"
                             Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </DataTemplate>
        <!-- A row in a membership list that is added or removed on screen but not yet saved. Italic for both,
             green for an add and grey for a removal, alongside the Pending column that says it in words. -->
        <Style x:Key="PendingRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Pending}" Value="Adding">
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="Foreground" Value="#1B6E1B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Pending}" Value="Removing">
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="Foreground" Value="#888" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- "Working on it": a highlight that sweeps along the bar, for work with no known length. The app's own
             ProgressBar template shows a solid, unmoving bar when IsIndeterminate is set, so this is its own
             template. The sweep is a gradient mask moved in relative units, so it crosses any width. It runs only
             while the bar is visible: a running animation makes WPF redraw constantly, even behind a hidden bar.
             Background is the track, Foreground the sweep. -->
        <Style x:Key="BusyBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="IsIndeterminate" Value="True" />
            <Setter Property="Background" Value="#E6E6E6" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True"
                                SnapsToDevicePixels="True">
                            <Rectangle x:Name="Sweep" Fill="{TemplateBinding Foreground}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform X="-1" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="Transparent" Offset="0.15" />
                                        <GradientStop Color="Black" Offset="0.5" />
                                        <GradientStop Color="Transparent" Offset="0.85" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="SweepRun">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sweep"
                                                             Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                             From="-1" To="1" Duration="0:0:1.4" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SweepRun" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- While the pane is busy everything in it is disabled (see the header and the tabs), so a wait cursor is
         forced across the whole pane. Disabled elements pass the cursor query up to this enabled root. -->
    <Grid x:Name="PaneRoot">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="Cursor" Value="Wait" />
                        <Setter Property="ForceCursor" Value="True" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <!-- Empty state: nothing selected, or the object still loading (a load blanks the pane on purpose; see
             LoadAsync). This was bound to HasObject without inverting it from 1.2.0 until 2.3.9, so the hint
             showed only behind a loaded object, and so was never seen. -->
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" Margin="16">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasObject}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock x:Name="EmptyStateText" Foreground="#999" HorizontalAlignment="Center" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Select an object to view and edit its attributes." />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Text" Value="{Binding BusyMessage}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ProgressBar Style="{StaticResource BusyBar}" Width="160" Margin="0,8,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <DockPanel Visibility="{Binding HasObject, Converter={StaticResource BoolToVis}}">
            <!-- Header -->
            <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- What the pane is doing, while it does it. Cloud and Exchange writes take seconds each. -->
                    <StackPanel x:Name="BusyPanel" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Style="{StaticResource BusyBar}" Background="#40FFFFFF" Foreground="White" />
                        <TextBlock x:Name="BusyText" Text="{Binding BusyMessage}" Foreground="White" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <WrapPanel x:Name="HeaderButtons" Margin="0,6,0,0"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                        <Button Content="Save" Command="{Binding SaveCommand}" />
                        <Button Content="Reload" Command="{Binding ReloadCommand}" />
                        <Button Content="Enable" Command="{Binding EnableCommand}"
                                Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Disable" Command="{Binding DisableCommand}"
                                Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Reset Password…" Command="{Binding ResetPasswordCommand}"
                                Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Unlock" Command="{Binding UnlockCommand}"
                                Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- Disabled while busy: a save reloads the object when it finishes, so anything typed meanwhile would
                 be silently replaced. -->
            <TabControl x:Name="ObjectTabs" Margin="6"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <ItemsControl ItemsSource="{Binding General}" ItemTemplate="{StaticResource FieldRow}" />

                            <!-- Groups: scope + category (written back as the groupType bitmask) and Managed by. -->
                            <StackPanel Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,2" Visibility="{Binding ShowGroupType, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Group scope" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding GroupScopeOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding GroupScope}"
                                              ToolTip="Global, Domain local or Universal. Active Directory can't convert directly between Global and Domain local — go via Universal." />
                                </Grid>
                                <Grid Margin="0,2" Visibility="{Binding ShowGroupType, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Group type" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding GroupCategoryOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding GroupCategory}"
                                              ToolTip="Security groups can be granted permissions; distribution groups are for mail only." />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Managed by" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding ManagedByDisplay, Mode=OneWay}" IsReadOnly="True" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="Pick…" Command="{Binding PickManagedByCommand}" />
                                        <Button Content="Clear" Command="{Binding ClearManagedByCommand}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Location (OU)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Location}" IsReadOnly="True" Background="#F3F3F3" Foreground="#666"
                                         ToolTip="The container the object lives in. Use Move… to relocate it." />
                                <Button Grid.Column="2" Content="Move…" Margin="6,0,0,0" Command="{Binding MoveCommand}" />
                            </Grid>
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                                <StackPanel>
                                    <CheckBox Content="Protect object from accidental deletion"
                                              IsChecked="{Binding IsProtectedFromDeletion}"
                                              ToolTip="Adds (or removes) a Deny-Everyone Delete / Delete-subtree ACE, the same as the ADUC checkbox." />
                                    <TextBlock Text="Click Save (top of pane) to apply." Foreground="#999" FontSize="11" Margin="22,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Account" Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <ItemsControl ItemsSource="{Binding Account}" ItemTemplate="{StaticResource FieldRow}" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Lockout status" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding LockoutStatus}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLockedOut}" Value="True">
                                                    <Setter Property="Foreground" Value="#B00020" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <!-- Password options. Disabled until they have actually been read: an unticked box from a
                                 failed read is not a decision, and saving it would clear a setting the account has. -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                                <StackPanel IsEnabled="{Binding PasswordOptionsKnown}">
                                    <TextBlock Text="Password options" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <CheckBox Content="Password never expires" IsChecked="{Binding PasswordNeverExpires}"
                                              ToolTip="Sets DONT_EXPIRE_PASSWORD in userAccountControl. Overrides the domain password age policy for this account." />
                                    <CheckBox Content="User cannot change password" IsChecked="{Binding CannotChangePassword}" Margin="0,4,0,0"
                                              ToolTip="A permission on the account, not a flag: denies the Change Password right to Everyone and SELF. An administrator can still reset the password." />
                                    <TextBlock Text="Could not read these options, so they cannot be changed here."
                                               Foreground="#B00" FontSize="11" Margin="0,4,0,0"
                                               Visibility="{Binding PasswordOptionsUnreadable, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Account expiration" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <CheckBox Content="Never expires" IsChecked="{Binding AccountNeverExpires}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Expires on (date / time)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                        <DatePicker Grid.Column="1" SelectedDate="{Binding AccountExpiresDate}"
                                                    IsEnabled="{Binding AccountNeverExpires, Converter={StaticResource InverseBool}}" />
                                        <TextBox Grid.Column="2" Width="64" Margin="6,0,0,0" Text="{Binding AccountExpiresTime, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding AccountNeverExpires, Converter={StaticResource InverseBool}}"
                                                 ToolTip="24-hour time, e.g. 17:30" />
                                    </Grid>
                                    <TextBlock Text="Click Save (top of pane) to apply expiration and other changes."
                                               Foreground="#999" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Address" Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <ItemsControl ItemsSource="{Binding Address}" ItemTemplate="{StaticResource FieldRow}" />
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Country/region" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Countries}" DisplayMemberPath="Display"
                                          SelectedItem="{Binding SelectedCountry}" IsEditable="True" IsTextSearchEnabled="True"
                                          MaxDropDownHeight="320"
                                          ToolTip="Sets co (name), c (two-letter code) and countryCode (numeric) together." />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Organization" Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Manager" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                <TextBox  Grid.Column="1" Text="{Binding ManagerDisplay, Mode=OneWay}" IsReadOnly="True" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="Pick…" Command="{Binding PickManagerCommand}" />
                                    <Button Content="Clear" Command="{Binding ClearManagerCommand}" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Organization}" ItemTemplate="{StaticResource FieldRow}" />

                            <TextBlock Text="Direct reports" Style="{StaticResource FieldLabel}" Margin="0,14,0,2" />
                            <TextBlock Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="Users who report to this user (their Manager is set to this user). Ctrl/Shift-click to select several. Additions and removals are applied when you click Save." />
                            <ListView x:Name="DirectReportsList" ItemsSource="{Binding DirectReports}"
                                      SelectionMode="Extended" MinHeight="110" MaxHeight="220"
                                      ItemContainerStyle="{StaticResource PendingRowStyle}"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" Width="320" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Pending" Width="130" DisplayMemberBinding="{Binding PendingLabel}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Add direct reports…" Command="{Binding AddDirectReportsCommand}" />
                                <Button Content="Remove selected" Command="{Binding RemoveDirectReportsCommand}"
                                        CommandParameter="{Binding SelectedItems, ElementName=DirectReportsList}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Email" Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="6">
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Email}" ItemTemplate="{StaticResource FieldRow}" />
                        <TextBlock DockPanel.Dock="Top" Text="Proxy addresses" Style="{StaticResource FieldLabel}" Margin="0,10,0,2" />
                        <TextBlock DockPanel.Dock="Top" Foreground="#999" FontSize="11"
                                   Text="(edit individual values in the Attribute Editor tab)" Margin="0,0,0,4" />
                        <ListBox ItemsSource="{Binding ProxyAddresses}" />
                    </DockPanel>
                </TabItem>

                <TabItem Header="Cloud" Visibility="{Binding ShowCloudTab, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6" DataContext="{Binding Cloud}">
                            <!-- Header: cloud connection + signed-in account (sign-in is configured in File ▸ Settings) -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Entra ID (synced object)" FontWeight="SemiBold" />
                                    <TextBlock Foreground="#666" FontSize="11" Margin="0,2,0,0"
                                               Text="{Binding SignedInAccount, TargetNullValue='Signed in as: (not signed in)', StringFormat='Signed in as: {0}'}" />
                                </StackPanel>
                            </Border>

                            <!-- Lookup action + status line -->
                            <WrapPanel>
                                <Button Content="Look up in Entra ID" Command="{Binding LookUpCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#666" Margin="0,6,0,2" />

                            <!-- Resolved cloud object: the SAME comprehensive detail (and cloud user actions)
                                 as the standalone cloud section, for tight on-prem/cloud unification. -->
                            <ctrl:CloudDetailView DataContext="{Binding Detail}" MinHeight="320"
                                                  Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="ExOL" Visibility="{Binding ShowExchangeTab, Converter={StaticResource BoolToVis}}">
                    <ctrl:ExchangeActionsView DataContext="{Binding Exchange}" />
                </TabItem>

                <TabItem Header="Members" Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="6">
                        <TextBlock DockPanel.Dock="Top" Text="Objects that belong to this group (click a column header to sort; Ctrl/Shift-click to select several). Additions and removals are applied when you click Save." Foreground="#666" Margin="0,0,0,4" TextWrapping="Wrap" />
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button Content="Add members…" Command="{Binding AddMembersCommand}" />
                            <Button Content="Paste a list…" Command="{Binding PasteMembersCommand}" Margin="6,0,0,0"
                                    ToolTip="Paste many people at once — addresses, logon names or names — and review what each line resolved to before anything is added." />
                            <Button Content="Remove selected" Command="{Binding RemoveMemberCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=MembersList}" />
                        </WrapPanel>
                        <ListView x:Name="MembersList" ItemsSource="{Binding Members}"
                                  SelectionMode="Extended" VirtualizingStackPanel.IsVirtualizing="False"
                                  ItemContainerStyle="{StaticResource PendingRowStyle}"
                                  GridViewColumnHeader.Click="OnMembersHeaderClick"
                                  MouseDoubleClick="OnMemberDoubleClick"
                                  ToolTip="Double-click a member to open it.">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="320" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Pending" Width="130" DisplayMemberBinding="{Binding PendingLabel}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Member Of">
                    <DockPanel Margin="6">
                        <TextBlock DockPanel.Dock="Top" Foreground="#666" Margin="0,0,0,4" TextWrapping="Wrap"
                                   Text="Groups this object belongs to — on-prem AD and Entra ID together (Ctrl/Shift-click to select several; Ctrl+C or right-click ▸ Copy to copy the list). Additions and removals are applied when you click Save. Membership of a group synced from on-prem AD is mastered on-prem." />
                        <!-- The cloud groups arrive seconds after the rest; until then the list is short. -->
                        <StackPanel x:Name="CloudGroupsLoading" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4"
                                    Visibility="{Binding IsLoadingCloudGroups, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Style="{StaticResource BusyBar}" Width="80" VerticalAlignment="Center" />
                            <TextBlock Text="Loading cloud groups…" Foreground="#666" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button Content="Add to groups…" Command="{Binding AddToGroupsCommand}" />
                            <Button Content="Remove selected" Command="{Binding RemoveFromGroupCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=MemberOfList}" />
                            <Button Content="Copy" Click="OnCopyMemberOf"
                                    ToolTip="Copy the selected groups (or all, if none are selected) as tab-separated text — paste into a text file or Excel." />
                            <Button Content="Copy groups to user…" Command="{Binding CopyGroupsToUserCommand}"
                                    ToolTip="Copy this user's group memberships onto another user (pick which to copy)." />
                        </WrapPanel>
                        <ListView x:Name="MemberOfList" ItemsSource="{Binding MemberOf}"
                                  SelectionMode="Extended" VirtualizingStackPanel.IsVirtualizing="False"
                                  KeyDown="OnMemberOfKeyDown"
                                  ItemContainerStyle="{StaticResource PendingRowStyle}"
                                  GridViewColumnHeader.Click="OnMemberOfHeaderClick">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy selected" Click="OnCopyMemberOf" />
                                    <MenuItem Header="Copy all" Click="OnCopyAllMemberOf" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Group" Width="240" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Type" Width="140" DisplayMemberBinding="{Binding Kind}" />
                                    <GridViewColumn Header="Source" Width="90" DisplayMemberBinding="{Binding Source}" />
                                    <GridViewColumn Header="Pending" Width="130" DisplayMemberBinding="{Binding PendingLabel}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Attribute Editor">
                    <DockPanel Margin="6">
                        <TextBlock DockPanel.Dock="Top" Foreground="#999" FontSize="11" Margin="0,0,0,4"
                                   Text="Edit single-valued attributes inline; use Edit… for multi-valued. Read-only/system attributes are shown as plain grayed text you can still select and copy. Click Save (top) to apply." />
                        <ListView ItemsSource="{Binding AllAttributes}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Attribute" Width="170" DisplayMemberBinding="{Binding FriendlyName}" />
                                    <GridViewColumn Header="LDAP name" Width="150" DisplayMemberBinding="{Binding LdapName}" />
                                    <GridViewColumn Header="Value" Width="340">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <!-- Single-valued, editable: inline text box -->
                                                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding IsSingleValueEditable, Converter={StaticResource BoolToVis}}" />
                                                    <!-- Single-valued, read-only: static grayed text that's still selectable/copyable -->
                                                    <TextBox Text="{Binding DisplaySummary, Mode=OneWay}" Style="{StaticResource ReadOnlyValueBox}"
                                                             ToolTip="{Binding DisplaySummary}"
                                                             Visibility="{Binding IsSingleValueReadOnly, Converter={StaticResource BoolToVis}}" />
                                                    <!-- Multi-valued: summary + Edit button -->
                                                    <DockPanel Visibility="{Binding IsMultiValued, Converter={StaticResource BoolToVis}}">
                                                        <Button DockPanel.Dock="Right" Content="Edit…" Padding="6,1" Margin="6,0,0,0"
                                                                Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.EditAttributeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <TextBlock Text="{Binding DisplaySummary}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>
