<Window x:Class="UnifiedDirectoryManager.Views.Dialogs.DistributionGroupMembersWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Distribution group members" Height="520" Width="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="OnLoaded">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" FontWeight="SemiBold"
                   Text="{Binding GroupName}" />

        <!-- Replaces the buttons entirely when the group is on-prem-mastered: an explanation is more use than a
             row of controls that would each fail with the same message. -->
        <Border Grid.Row="1" Background="#FFF8E1" BorderBrush="#E6C200" BorderThickness="1" Padding="8" Margin="0,0,0,8"
                Visibility="{Binding IsSynced, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding SyncedNotice}" TextWrapping="Wrap" Foreground="#6B5300" />
        </Border>

        <ListView Grid.Row="2" x:Name="MembersList" ItemsSource="{Binding Members}"
                  SelectionMode="Extended" VirtualizingStackPanel.IsVirtualizing="False">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Member" Width="220" DisplayMemberBinding="{Binding DisplayName}" />
                    <GridViewColumn Header="Address" Width="250" DisplayMemberBinding="{Binding PrimarySmtpAddress}" />
                    <GridViewColumn Header="Type" Width="150" DisplayMemberBinding="{Binding RecipientType}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Buttons dock right FIRST so they always reserve their width; a long status line then wraps into
             whatever is left instead of squeezing them to nothing. -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Add members…" Command="{Binding AddMembersCommand}" MinWidth="110"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                        IsEnabled="{Binding CanWriteNow}" />
                <Button Content="Remove selected" Click="OnRemoveSelected" MinWidth="110" Margin="6,0,0,0"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                        IsEnabled="{Binding CanWriteNow}" />
                <Button Content="Close" IsCancel="True" MinWidth="90" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="#666" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
        </DockPanel>
    </Grid>
</Window>
