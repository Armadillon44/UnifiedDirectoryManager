<Window x:Class="UnifiedDirectoryManager.Views.Dialogs.NewGroupWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Group" Height="520" Width="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Create in" Foreground="#666" Margin="0,0,10,8" VerticalAlignment="Center" />
        <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Command="{Binding BrowseParentCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            <TextBox Text="{Binding ParentDn, Mode=OneWay}" IsReadOnly="True" Background="#F7F7F7" TextWrapping="Wrap"
                     ToolTip="The OU or container the group is created in. Use Browse… to choose a different one." />
        </DockPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Group name" Foreground="#666" Margin="0,0,10,8" VerticalAlignment="Center" />
        <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Margin="0,0,0,8">
            <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding CreateCommand}" />
            </TextBox.InputBindings>
        </TextBox>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Logon name" Foreground="#666" Margin="0,0,10,8" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SamAccountName, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Margin="0,0,0,8"
                 ToolTip="sAMAccountName — follows the group name until you edit it. Must be unique in the domain." />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Group scope" Foreground="#666" Margin="0,0,10,8" VerticalAlignment="Center" />
        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ScopeOptions}" DisplayMemberPath="Label"
                  SelectedValuePath="Value" SelectedValue="{Binding Scope}" Margin="0,0,0,8"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Group type" Foreground="#666" Margin="0,0,10,8" VerticalAlignment="Center" />
        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Label"
                  SelectedValuePath="Value" SelectedValue="{Binding Category}" Margin="0,0,0,8"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                  ToolTip="Security groups can be granted permissions; distribution groups are for mail only." />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Description" Foreground="#666" Margin="0,0,10,8" VerticalAlignment="Top" />
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" TextWrapping="Wrap"
                 AcceptsReturn="False" MinLines="2" MaxHeight="60" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />

        <CheckBox Grid.Row="6" Grid.Column="1" Content="Protect object from accidental deletion"
                  IsChecked="{Binding ProtectFromDeletion}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                  Margin="0,2,0,8" />

        <DockPanel Grid.Row="7" Grid.Column="1" Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Members (optional)" Foreground="#666" Margin="0,0,0,4" />
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                <Button Content="Add members…" Command="{Binding AddMembersCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </WrapPanel>
            <Border BorderBrush="#DDD" BorderThickness="1" MinHeight="70">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Members}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <Button DockPanel.Dock="Right" Content="✕" Width="22" MinWidth="22" Padding="0"
                                            Command="{Binding DataContext.RemoveMemberCommand, ElementName=Root}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Dn}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!-- Buttons dock FIRST so they always reserve their width; a long "Create failed: …" status then wraps
             into whatever is left instead of squeezing them to zero. -->
        <DockPanel Grid.Row="8" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Create" IsDefault="True" Command="{Binding CreateCommand}" MinWidth="90" />
                <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="#666" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
        </DockPanel>
    </Grid>
</Window>
