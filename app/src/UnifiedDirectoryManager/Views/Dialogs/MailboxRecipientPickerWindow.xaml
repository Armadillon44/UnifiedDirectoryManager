<Window x:Class="UnifiedDirectoryManager.Views.Dialogs.MailboxRecipientPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select recipient" Height="480" Width="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="#666" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="{Binding Heading}" />

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}" Margin="6,0,0,0" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" x:Name="ResultsList" ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedResult}" SelectionMode="{Binding ResultsSelectionMode}"
                      VirtualizingStackPanel.IsVirtualizing="False"
                      MouseDoubleClick="OnResultDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Recipient" Width="180" DisplayMemberBinding="{Binding DisplayName}" />
                        <GridViewColumn Header="Address" Width="210" DisplayMemberBinding="{Binding PrimarySmtpAddress}" />
                        <GridViewColumn Header="Type" Width="130" DisplayMemberBinding="{Binding RecipientType}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- The basket only exists in multi-select mode; single-select keeps the original layout exactly. -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0"
                        Visibility="{Binding MultiSelect, Converter={StaticResource BoolToVis}}">
                <Button Content="Add →" MinWidth="70" Padding="6,3" Click="OnAddToBasket"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        ToolTip="Add the selected results to the list on the right. The search can be run again without losing them." />
            </StackPanel>

            <DockPanel Grid.Column="2" Width="220"
                       Visibility="{Binding MultiSelect, Converter={StaticResource BoolToVis}}">
                <TextBlock DockPanel.Dock="Top" Text="Selected" Foreground="#666" Margin="0,0,0,4" />
                <Border BorderBrush="#DDD" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Basket}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1">
                                        <Button DockPanel.Dock="Right" Content="✕" Width="22" MinWidth="22" Padding="0"
                                                Command="{Binding DataContext.RemoveFromBasketCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding PrimarySmtpAddress}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <!-- Buttons dock right FIRST so they always reserve their width; the status text then fills + wraps
                 in whatever remains (previously the long status text squeezed OK down to an unclickable sliver). -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="OK" IsDefault="True" Click="OnOk" MinWidth="90" Margin="0,0,6,0" />
                <Button Content="Cancel" IsCancel="True" MinWidth="90" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="#666" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
        </DockPanel>
    </Grid>
</Window>
