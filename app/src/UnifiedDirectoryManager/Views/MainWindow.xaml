<Window x:Class="UnifiedDirectoryManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UnifiedDirectoryManager.ViewModels"
        xmlns:ctrl="clr-namespace:UnifiedDirectoryManager.Views.Controls"
        Title="Unified Directory Manager" Height="760" Width="1240" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!--
          Menu bar, laid out the way MMC lays one out: File / Action / View / Tools / Help, with New as a
          submenu inside Action. Audit finding P8 — the previous shape had four creates in File and a
          fifth nowhere, and split actions on the selection across File, Edit and Tools, so knowing where
          one thing lived predicted nothing about the next. ADUC, DNS, DHCP and Certificates all use this
          layout, so it is the one an AD administrator already knows before they look.

          Two rules hold across every item below and are asserted by test-ui-placement:

            Visibility binds ONLY to IsAdView or IsCloudView. Hiding by VIEW is honest — a cloud user has
            no lockout to clear, so Unlock does not belong in the cloud vocabulary at all. Hiding by
            SELECTION is not: it teaches "if it is not here it does not exist", which is the lesson this
            whole audit is undoing. Selection gates items with CanExecute, so they grey out instead.

            Every command either view model exposes is reachable from here. Rule 1, and it now covers the
            cloud list too, which until P8 had its actions in no menu at all.
        -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <!-- Exports write out the LIST you are looking at, not the rows you picked — which is why
                     they are here and Export Group Members is in Action. The cloud list makes a real
                     distinction between the page it has loaded and everything behind it, so both of its
                     exports appear rather than one of them being chosen silently. -->
                <MenuItem Header="_Export List to CSV…" Command="{Binding ExportCsvCommand}" Visibility="{Binding IsAdView, Converter={StaticResource BoolToVis}}" />
                <MenuItem Header="Export _Loaded to CSV…" Command="{Binding Cloud.ExportCsvCommand}" Visibility="{Binding IsCloudView, Converter={StaticResource BoolToVis}}" />
                <MenuItem Header="Export _All to CSV…" Command="{Binding Cloud.ExportAllCsvCommand}" Visibility="{Binding IsCloudView, Converter={StaticResource BoolToVis}}" />
                <Separator />
                <MenuItem Header="_Settings…" Command="{Binding OpenSettingsCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>

            <!--
              Action, on-prem. There are two Action menus rather than one with per-item Visibility: the
              menu swaps wholesale with the view, IsAdView and IsCloudView are strict complements so
              exactly one is ever shown, and separators would otherwise need visibility logic of their own.
              Grouped by what each item acts on: identity, then account state, then the copy/derive
              actions, then the ones that move or change the whole selection, then the destructive one.
            -->
            <MenuItem Header="_Action" Visibility="{Binding IsAdView, Converter={StaticResource BoolToVis}}">
                <MenuItem Header="_New">
                    <MenuItem Header="_User…" Command="{Binding NewUserCommand}" />
                    <MenuItem Header="_Bulk Create Users…" Command="{Binding BulkCreateUsersCommand}" />
                    <MenuItem Header="_Group…" Command="{Binding NewGroupCommand}" />
                    <!-- Creates under the selected TREE node, like the tree's own right-click entry. -->
                    <MenuItem Header="_OU…" Command="{Binding CreateOuHereCommand}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Properties…" Command="{Binding OpenSelectedCommand}" />
                <Separator />
                <MenuItem Header="_Enable Account(s)" Command="{Binding EnableSelectedCommand}" />
                <MenuItem Header="_Disable Account(s)" Command="{Binding DisableSelectedCommand}" />
                <MenuItem Header="Un_lock Account(s)" Command="{Binding UnlockSelectedCommand}" />
                <MenuItem Header="_Reset Password…" Command="{Binding ResetPasswordSelectedCommand}" />
                <Separator />
                <MenuItem Header="Cop_y User…" Command="{Binding CopyUserCommand}" />
                <MenuItem Header="Copy Groups to _User…" Command="{Binding CopyGroupsToUserCommand}" />
                <MenuItem Header="Save as Te_mplate…" Command="{Binding SaveSelectedAsTemplateCommand}" />
                <Separator />
                <MenuItem Header="Add to Gr_oups…" Command="{Binding AddSelectedToGroupsCommand}" />
                <MenuItem Header="Mo_ve to OU…" Command="{Binding MoveSelectedToOuCommand}" />
                <MenuItem Header="Bul_k Edit…" Command="{Binding BulkEditCommand}" />
                <Separator />
                <!-- These act on the groups you SELECTED, unlike File's list export. -->
                <MenuItem Header="Export _Group Members to CSV…" Command="{Binding ExportGroupMembersCommand}" />
                <MenuItem Header="Append Group Members to _CSV…" Command="{Binding AppendGroupMembersCommand}" />
                <MenuItem Header="Run _Scenario on Selected" ItemsSource="{Binding ScenarioMenuItems}" IsEnabled="{Binding HasScenarios}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Name}" />
                            <Setter Property="Command" Value="{Binding RunCommand}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="Delete Selec_ted…" Command="{Binding DeleteSelectedCommand}" />
            </MenuItem>

            <!--
              Action, cloud. Same menu, same position, contents following the view. Until P8 none of these
              were in the menu bar at all: they live on CloudObjectListViewModel, and rule 1's test only
              ever scanned MainViewModel, so the cloud half of the app quietly taught the opposite lesson
              to the on-prem half.
            -->
            <MenuItem Header="_Action" Visibility="{Binding IsCloudView, Converter={StaticResource BoolToVis}}">
                <MenuItem Header="_New">
                    <MenuItem Header="_Cloud Group…" Command="{Binding NewCloudGroupCommand}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Properties…" Command="{Binding Cloud.OpenSelectedCommand}" />
                <Separator />
                <MenuItem Header="_Enable Account(s)" Command="{Binding Cloud.EnableSelectedCommand}" />
                <MenuItem Header="_Disable Account(s)" Command="{Binding Cloud.DisableSelectedCommand}" />
                <MenuItem Header="_Revoke Sessions" Command="{Binding Cloud.RevokeSelectedCommand}" />
                
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="_Refresh" Command="{Binding RefreshCommand}" />
                <MenuItem Header="Toggle Pane _Dock (Right / Bottom)" Command="{Binding ToggleDockCommand}" />
                <Separator />
                <!--
                  Both submenus act on the SELECTED TREE NODE, not on the list selection, which is why
                  they are here and not in Action. Keeping the two apart is the whole point: one menu
                  meaning "the row I picked" and another meaning "the folder I picked" is learnable; one
                  menu that means whichever pane you touched last is not.

                  Favourites is a whole feature that was invisible unless an operator guessed the
                  right-click gesture (audit findings P2 and P3). Creating an OU used to be here too and
                  moved to Action ▸ New with the other creates; Properties and Delete OU stayed.
                -->
                <MenuItem Header="_Favourites">
                    <MenuItem Header="_Pin to Favourites" Command="{Binding PinSelectedNodeCommand}" />
                    <MenuItem Header="U_npin from Favourites" Command="{Binding UnpinSelectedNodeCommand}" />
                    <Separator />
                    <MenuItem Header="Move _Up" Command="{Binding MoveSelectedFavoriteUpCommand}" />
                    <MenuItem Header="Move _Down" Command="{Binding MoveSelectedFavoriteDownCommand}" />
                </MenuItem>
                <MenuItem Header="Selected F_older">
                    <MenuItem Header="_Properties…" Command="{Binding SelectedNodePropertiesCommand}" />
                    <Separator />
                    <MenuItem Header="_Delete OU…" Command="{Binding DeleteSelectedOuCommand}" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Tools">
                <!-- Finding things and managing the app's own machinery. Advanced Search is a find, not an
                     edit, which is what it was filed under before P8. -->
                <MenuItem Header="_Advanced Search…" Command="{Binding AdvancedSearchCommand}" Visibility="{Binding IsAdView, Converter={StaticResource BoolToVis}}" />
                <Separator Visibility="{Binding IsAdView, Converter={StaticResource BoolToVis}}" />
                <MenuItem Header="_Entra Connect Delta Sync…" Command="{Binding EntraSyncCommand}" />
                <MenuItem Header="_Manage Scenarios…" Command="{Binding ManageScenariosCommand}" />
                <MenuItem Header="User _Templates…" Command="{Binding ManageTemplatesCommand}" Visibility="{Binding IsAdView, Converter={StaticResource BoolToVis}}" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="View _README…" Command="{Binding ViewReadmeCommand}" />
                <Separator />
                <MenuItem Header="_View Log File…" Command="{Binding ViewLogCommand}" />
                <MenuItem Header="Open Logs _Folder" Command="{Binding OpenLogsCommand}" />
                <Separator />
                <MenuItem Header="_About Unified Directory Manager…" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Toolbar. On-prem-specific actions hide in the cloud view (IsAdView); the cloud list has its
             own toolbar for search/filter/columns/export. Refresh, Dock and Logs apply to both views. -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <ToolBar.Resources>
                    <!-- Keep the App.xaml Button template (BasedOn) but give toolbar buttons breathing room. -->
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Margin" Value="3,1" />
                        <Setter Property="Padding" Value="9,3" />
                    </Style>
                </ToolBar.Resources>
                <Button Content="New User…" Command="{Binding NewUserCommand}" Visibility="{Binding IsAdView, Converter={StaticResource BoolToVis}}" />
                <Button Content="Bulk Create Users…" Command="{Binding BulkCreateUsersCommand}" Visibility="{Binding IsAdView, Converter={StaticResource BoolToVis}}" />
                <Button Content="User Templates…" Command="{Binding ManageTemplatesCommand}" Visibility="{Binding IsAdView, Converter={StaticResource BoolToVis}}" />
                <Separator Visibility="{Binding IsAdView, Converter={StaticResource BoolToVis}}" />
                <Button Content="Advanced Search…" Command="{Binding AdvancedSearchCommand}" Visibility="{Binding IsAdView, Converter={StaticResource BoolToVis}}" />
                <Button Content="Add to Groups…" Command="{Binding AddSelectedToGroupsCommand}" Visibility="{Binding IsAdView, Converter={StaticResource BoolToVis}}" />
                <Button Content="Bulk Edit…" Command="{Binding BulkEditCommand}" Visibility="{Binding IsAdView, Converter={StaticResource BoolToVis}}" />
                <Separator Visibility="{Binding IsAdView, Converter={StaticResource BoolToVis}}" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Export List to CSV…" Command="{Binding ExportCsvCommand}" Visibility="{Binding IsAdView, Converter={StaticResource BoolToVis}}" />
                <Separator />
                <Button Content="Open Logs Folder" Command="{Binding OpenLogsCommand}" />
            </ToolBar>
        </ToolBarTray>

        <!-- Not-connected warning bar (yellow). Shown when on-prem AD isn't bound; the app stays usable
             (cloud management) and the user can connect from here. Hidden once AdWarning is cleared. -->
        <Border DockPanel.Dock="Top" Background="#FFF4CE" BorderBrush="#E0C36A" BorderThickness="0,0,0,1" Padding="10,6"
                Visibility="{Binding AdWarning, Converter={StaticResource NonEmptyToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Connect…" Command="{Binding OpenSettingsCommand}" Margin="10,0,0,0" />
                <TextBlock Text="⚠" Foreground="#B8860B" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding AdWarning}" Foreground="#5C4700" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Status bar. The right-hand item tracks the active view (on-prem list vs cloud list). -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource AccentLight}">
            <StatusBarItem><TextBlock Text="{Binding ConnectedInfo}" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock Text="{Binding StatusMessage}" /></StatusBarItem>
            <Separator />
            <StatusBarItem Visibility="{Binding IsAdView, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding List.Status}" />
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsCloudView, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Cloud.Status}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Main content -->
        <Grid x:Name="RootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation tree -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Style="{StaticResource HeaderBar}">
                    <TextBlock Text="Directory" Style="{StaticResource HeaderBarText}" />
                </Border>
                <TreeView x:Name="Tree" ItemsSource="{Binding RootNodes}"
                          SelectedItemChanged="OnTreeSelectedItemChanged" BorderThickness="0,1,0,0"
                          AllowDrop="True" DragOver="OnTreeDragOver" Drop="OnTreeDrop"
                          ToolTip="Drag objects from the list onto an OU here to move them.">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                            <!-- ContextMenuOpening suppresses the menu on nodes with no actions at all
                                 ("Loading…", the tenant roots); each item below gates itself from there. -->
                            <StackPanel Orientation="Horizontal" Background="Transparent"
                                        ContextMenuOpening="OnNodeContextMenuOpening"
                              PreviewMouseRightButtonDown="OnNodePreviewMouseRightButtonDown">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="New OU Here…" Click="OnNodeCreateOuClick"
                                                  Visibility="{Binding CanCreateChildOu, Converter={StaticResource BoolToVis}}" />
                                        <!-- Groups are legal in plain containers (CN=Users) as well as OUs, so this
                                             is gated on IsContainerNode rather than the OU-only CanCreateChildOu. -->
                                        <MenuItem Header="New Group Here…" Click="OnNodeNewGroupClick"
                                                  Visibility="{Binding IsContainerNode, Converter={StaticResource BoolToVis}}" />
                                        <!-- Cloud groups have no container, so this hangs off the group LISTS. -->
                                        <MenuItem Header="New Cloud Group…" Click="OnNodeNewCloudGroupClick"
                                                  Visibility="{Binding CanCreateCloudGroup, Converter={StaticResource BoolToVis}}" />
                                        <MenuItem Header="Pin to Favourites" Click="OnNodePinClick"
                                                  Visibility="{Binding CanPin, Converter={StaticResource BoolToVis}}" />
                                        <MenuItem Header="Move up" Click="OnNodeMoveFavoriteUpClick"
                                                  Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                        <MenuItem Header="Move down" Click="OnNodeMoveFavoriteDownClick"
                                                  Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                        <MenuItem Header="Unpin from Favourites" Click="OnNodeUnpinClick"
                                                  Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                        <MenuItem Header="Properties…" Click="OnNodePropertiesClick"
                                                  Visibility="{Binding IsContainerNode, Converter={StaticResource BoolToVis}}" />
                                        <Separator Visibility="{Binding IsOrganizationalUnit, Converter={StaticResource BoolToVis}}" />
                                        <!-- Two-level guard: Delete only reveals "Yes, I'm sure…", which then requires
                                             typing a random confirmation string. OUs only. -->
                                        <MenuItem Header="Delete OU" Visibility="{Binding IsOrganizationalUnit, Converter={StaticResource BoolToVis}}">
                                            <MenuItem Header="Yes, I'm sure…" Click="OnNodeDeleteClick" />
                                        </MenuItem>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <TextBlock Text="{Binding Glyph}" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Name}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                    <Setter Property="Foreground" Value="#999" />
                                                    <Setter Property="ToolTip"
                                                            Value="This is pinned to something that could not be found — it may have been renamed, moved or deleted. Unpin it from its right-click menu." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <!-- On-prem AD: list + edit pane host (re-laid out by code-behind for right/bottom docking).
                 Shown when an on-prem tree node is selected. -->
            <Grid x:Name="PaneHost" Grid.Column="2" Visibility="{Binding IsAdView, Converter={StaticResource BoolToVis}}">
                <Border x:Name="ListHost">
                    <ctrl:ObjectListView DataContext="{Binding List}" />
                </Border>
                <GridSplitter x:Name="PaneSplitter" Background="#DDD" />
                <Border x:Name="EditHost" BorderBrush="#DDD" BorderThickness="1,0,0,0">
                    <ctrl:EditPaneView DataContext="{Binding Edit}" />
                </Border>
            </Grid>

            <!-- Entra ID (cloud) list + read-only properties pane (laid out by code-behind, same Right/Bottom
                 dock toggle as the on-prem pane). Shown when a cloud tree node is selected. -->
            <Grid x:Name="CloudPaneHost" Grid.Column="2" Visibility="{Binding IsCloudView, Converter={StaticResource BoolToVis}}">
                <Border x:Name="CloudListHost">
                    <ctrl:CloudObjectListView DataContext="{Binding Cloud}" />
                </Border>
                <GridSplitter x:Name="CloudPaneSplitter" Background="#DDD" />
                <Border x:Name="CloudDetailHost" BorderBrush="#DDD" BorderThickness="1,0,0,0">
                    <ctrl:CloudDetailView DataContext="{Binding Cloud.Detail}" />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
